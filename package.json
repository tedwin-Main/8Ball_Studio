{
  "name": "8ball-studio-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@8ball/frontend",
    "dev:backend": "npm run dev --workspace=@8ball/backend",
    "build": "npm run build --workspace=@8ball/frontend",
    "preview": "npm run preview --workspace=@8ball/frontend",
    "test": "npm run test --workspace=@8ball/frontend",
    "test:all": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.3"
  }
}
